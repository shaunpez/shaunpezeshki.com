---
import { categorySlug } from "../lib/posts"

interface Props {
  categories: string[]
}

const { categories } = Astro.props
const path = decodeURI(Astro.url.pathname).replace(/\/$/, "")
const items = [
  { label: "All", href: "/blog" },
  ...categories.map(category => ({ label: category, href: `/category/${categorySlug(category)}` })),
]
---

<div class="category-buttons">
  {items.map(({ label, href }) => (
    <a href={href} class="category-button" aria-current={path === href ? "page" : undefined}>{label}</a>
  ))}
</div>

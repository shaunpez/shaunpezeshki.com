---
// The opening of every top-level page: words on the left, a photo of me on the right.
import type { ImageMetadata } from "astro"
import Photo from "./Photo.astro"

interface Props {
  image: ImageMetadata
  alt: string
}

const { image, alt } = Astro.props
---

<section class="hero" data-reveal-group>
  <div class="shell hero__grid">
    <div class="hero__copy">
      <slot />
    </div>
    <div class="hero__photo" data-reveal>
      <Photo
        src={image}
        alt={alt}
        ratio="10 / 11"
        widths={[480, 760, 1100]}
        sizes="(min-width: 900px) 42vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

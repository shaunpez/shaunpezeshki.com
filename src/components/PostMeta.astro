---
// Category, date and reading time: one line, the same everywhere a story appears.
import { categoryUrl, formatDate, readingTime, type Post } from "../lib/posts"

interface Props {
  post: Post
}

const { post } = Astro.props
const { date, category } = post.data
---

<p class="post-meta">
  <a href={categoryUrl(category)}>{category}</a>
  <span>{formatDate(date)}</span>
  <span>{readingTime(post.body)}</span>
</p>

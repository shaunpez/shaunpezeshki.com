---
import type { ImageMetadata } from "astro"
import ArrowIcon from "./ArrowIcon.astro"
import Photo from "./Photo.astro"

interface Props {
  image: ImageMetadata
  alt: string
  title: string
  link?: { href: string; label: string }
  /** A small non-clickable status, shown where the link would go. */
  note?: string
  /** Put the photo on the right. Alternate rows to keep the page moving. */
  reverse?: boolean
}

const { image, alt, title, link, note, reverse = false } = Astro.props
---

<article class:list={["split-row", { "split-row--reverse": reverse }]} data-reveal>
  <Photo class="split-row__image" src={image} alt={alt} widths={[480, 900]} sizes="(min-width: 900px) 40vw, 100vw" />
  <div class="split-row__text">
    <h3>{title}</h3>
    <slot />
    {link && <a class="text-link" href={link.href}>{link.label} <ArrowIcon /></a>}
    {note && <p class="status-note">{note}</p>}
  </div>
</article>

---
// A section heading beside a few short paragraphs. SplitRow's sibling for when a photo would repeat.
import ArrowIcon from "./ArrowIcon.astro"

interface Props {
  title: string
  /** For the section's aria-labelledby. */
  id?: string
  link?: { href: string; label: string }
}

const { title, id, link } = Astro.props
---

<div class="text-row">
  <h2 id={id} data-reveal>{title}</h2>
  <div class="text-row__body" data-reveal>
    <slot />
    {link && <a class="text-link" href={link.href}>{link.label} <ArrowIcon /></a>}
  </div>
</div>

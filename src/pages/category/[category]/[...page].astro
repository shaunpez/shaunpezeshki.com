---
import type { GetStaticPaths } from "astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import CategoryNav from "../../../components/CategoryNav.astro"
import PostRow from "../../../components/PostRow.astro"
import Pagination from "../../../components/Pagination.astro"
import { POSTS_PER_PAGE, SITE, categorySlug, categoryUrl, getCategories, getPublishedPosts, postUrl } from "../../../lib/posts"

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts()
  const categories = getCategories(posts)
  return categories.flatMap(category => {
    const inCategory = posts.filter(post => post.data.category === category)
    const numPages = Math.ceil(inCategory.length / POSTS_PER_PAGE)
    return Array.from({ length: numPages }, (_, i) => ({
      params: { category: categorySlug(category), page: i === 0 ? undefined : String(i + 1) },
      props: {
        category,
        categories,
        total: inCategory.length,
        currentPage: i + 1,
        numPages,
        posts: inCategory.slice(i * POSTS_PER_PAGE, (i + 1) * POSTS_PER_PAGE),
      },
    }))
  })
}) satisfies GetStaticPaths

const { category, categories, total, currentPage, numPages, posts } = Astro.props
const path = categoryUrl(category)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: category,
  description: `${category} stories by Shaun Pezeshki.`,
  url: SITE.url + path,
  itemListElement: posts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: SITE.url + postUrl(post),
  })),
}
---

<BaseLayout
  title={`${category} stories`}
  description={`${category} stories by Shaun Pezeshki, from Threads of Perspective. Most come with a narrated version you can listen to.`}
  jsonLd={jsonLd}
  noindex={currentPage > 1}
>
  <section class="page-head" data-reveal-group>
    <div class="shell">
      <h1 data-reveal>{category}</h1>
      <p class="page-head__lede" data-reveal>{total} {total === 1 ? "story" : "stories"} from Threads of Perspective.</p>
      <CategoryNav categories={categories} />
    </div>
  </section>
  <section class="shell post-list" data-reveal-group>
    <div class="post-rows">{posts.map(post => <PostRow post={post} />)}</div>
    <Pagination currentPage={currentPage} numPages={numPages} first={path} base={path} />
  </section>
</BaseLayout>
